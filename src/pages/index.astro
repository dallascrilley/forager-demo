---
// Forager — Slack threads → queryable knowledge
import '../styles/forager.css';
import GuidedTour from '../components/demo/GuidedTour.astro';
import { GUIDED_TOURS } from '../data/guidedTours';
const title = "Forager — Your tribal knowledge is in Slack. Stop pretending the wiki has it.";
const description = "Harvest resolved Slack threads into a queryable knowledge base with confidence scoring and MCP server simulation.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div class="fr-root">
      <nav class="fr-nav" aria-label="Forager navigation">
        <span class="fr-logo">forager</span>
        <span class="fr-nav-sep" aria-hidden="true"></span>
        <span class="fr-nav-label">Internal Knowledge Harvester</span>
        <span class="fr-nav-spacer"></span>
        <span class="fr-nav-live">Uploads enabled</span>
        <span class="fr-nav-label fr-mode-badge" id="fr-mode-badge">Synthetic sample mode</span>
      </nav>

      <div class="fr-banner" role="status">
        <span class="fr-banner-icon" aria-hidden="true">◈</span>
        <p class="fr-banner-text" id="fr-banner-copy"><strong>Synthetic workspace only.</strong> These 10 Slack threads are fabricated, but the Q&A extraction logic, confidence scoring, and MCP response format are production-grade. <em>No real Slack data, no live API calls.</em></p>
      </div>

      <GuidedTour {...GUIDED_TOURS.forager} />

      <!-- Hero: foreground the RAG→MCP knowledge-server angle above the fold -->
      <section class="fr-hero" aria-label="What Forager does">
        <div class="fr-hero-lead">
          <h1 class="fr-hero-title">Your tribal knowledge is trapped in Slack threads.</h1>
          <p class="fr-hero-sub">Forager harvests the resolved Q&amp;A out of Slack, scores each answer's confidence, and serves it as an <strong>MCP server your agents can query directly</strong> — not another wiki nobody updates.</p>
        </div>
        <div class="fr-hero-flow" aria-label="Pipeline: Slack export to MCP server">
          <span class="fr-hero-step">Slack export</span>
          <span class="fr-hero-arrow" aria-hidden="true">→</span>
          <span class="fr-hero-step">Q&amp;A extraction</span>
          <span class="fr-hero-arrow" aria-hidden="true">→</span>
          <span class="fr-hero-step fr-hero-step-accent">MCP&nbsp;server</span>
        </div>
      </section>

      <section class="fr-import-panel" aria-label="Upload Slack export">
        <div class="fr-import-copy">
          <div class="fr-import-title">Upload a real Slack export</div>
          <p class="fr-import-body">Import a Slack channel export JSON file or paste normalized thread JSON. The backend groups messages into threads, extracts Q&A server-side, and swaps the UI from sample mode to your uploaded workspace.</p>
        </div>
        <div class="fr-import-controls">
          <label class="fr-upload-field">
            <span class="fr-upload-label">Slack export JSON</span>
            <input class="fr-upload-input" id="fr-upload-file" type="file" accept="application/json,.json" />
          </label>
          <div class="fr-upload-or">or paste JSON</div>
          <textarea class="fr-upload-text" id="fr-upload-text" rows="5" placeholder='[{"id":"thread_1","channel":"#engineering","messages":[...]}]'></textarea>
          <div class="fr-import-actions">
            <button class="fr-btn-primary" id="fr-import-btn" type="button">Import export</button>
            <button class="fr-btn-secondary" id="fr-sample-btn" type="button">Use sample workspace</button>
          </div>
          <div class="fr-upload-status" id="fr-upload-status" aria-live="polite">Upload a Slack export JSON file or paste normalized thread JSON.</div>
        </div>
      </section>

      <div class="fr-layout">
        <aside class="fr-sidebar" aria-label="Thread explorer">
          <div class="fr-sidebar-header">
            <div>
              <span class="fr-sidebar-title">Threads</span>
              <div class="fr-source-chip"><span id="fr-source-title">Sample workspace</span><span id="fr-source-detail">10 fabricated Slack threads with realistic failure-and-resolution patterns.</span></div>
            </div>
            <button class="fr-btn-secondary" id="fr-harvest-btn">Refresh lists</button>
          </div>
          <div class="fr-thread-list" id="fr-thread-list" role="list" aria-label="Slack threads"></div>
        </aside>

        <main class="fr-main" role="main">
          <section class="fr-query-section" aria-label="Knowledge query">
            <h2 class="fr-query-heading">Ask the knowledge base</h2>
            <div class="fr-query-bar">
              <input
                class="fr-query-input"
                id="fr-query-input"
                type="text"
                placeholder="How do we handle Stripe Connect refunds?"
                aria-label="Query"
              />
              <button class="fr-btn-primary" id="fr-query-btn">Query</button>
            </div>
            <div class="fr-query-results" id="fr-query-results"></div>
          </section>

          <section class="fr-kb-section" aria-label="Harvested knowledge">
            <div class="fr-kb-header">
              <span class="fr-kb-title">Harvested Q&A</span>
              <div class="fr-stats" id="fr-stats"></div>
            </div>
            <div class="fr-kb-list" id="fr-kb-list"></div>
          </section>
        </main>

        <aside class="fr-mcp" aria-label="MCP server panel">
          <div class="fr-mcp-header">
            <span class="fr-mcp-title">MCP Server</span>
          </div>
          <div class="fr-mcp-panel" id="fr-mcp-panel">
            <div class="fr-mcp-placeholder">
              Query the knowledge base to see the MCP response format.
            </div>
          </div>
        </aside>
      </div>

      <div class="fr-detail-panel hidden" id="fr-detail-panel" aria-label="Thread detail"></div>
    </div>
    <script>import '../components/app.ts';</script>
  </body>
</html>
